#!/bin/sh
echo "🔨 Pre-push: building dist/..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build gagal. Push dibatalkan."
  exit 1
fi
git add dist/
if ! git diff --cached --quiet; then
  echo "❌ dist/ berubah setelah build. Tolong jalankan:"
  echo "   git add dist/ && git commit -m 'build: rebuild dist'"
  echo "   kemudian push lagi."
  git restore --staged dist/
  exit 1
fi
echo "✅ Build selesai dan dist/ sudah up-to-date. Melanjutkan push..."
exit 0
